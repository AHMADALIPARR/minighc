cabal-version: 3.0
name: minighc
version: 0.9.0.0
synopsis: A miniature compiler for a small functional language
description:
  MiniGHC is a compiler for a small functional language with a
  bidirectional type checker, evaluator, Core IR, and free-variable analysis.
license: BSD-3-Clause
license-file: LICENSE
author: Ahmad Ali Parr, MiniGHC contributors
maintainer: ahmad.parr@snapkittywest.com
category: Compilers
build-type: Simple

library
  exposed-modules:
      MiniGHC
    , MiniGHC.Lint
    , MiniGHC.Analysis
    , MiniGHC.Analysis.Complex
    , MiniGHC.Calculi
    , MiniGHC.Calculi.HM
    , MiniGHC.Calculi.STLC
    , MiniGHC.Calculi.SystemF
    , MiniGHC.Geometry
    , MiniGHC.Geometry.Grassmann
    , MiniGHC.Geometry.Schubert
    , MiniGHC.Geometry.Umbral
    , MiniGHC.Operators
    , MiniGHC.Operators.Heaviside
    , MiniGHC.Operators.Quaternion
    , MiniGHC.Polynomial
  hs-source-dirs: src
  build-depends:
      base >=4.13 && <5
    , containers
  default-language: Haskell2010
  ghc-options: -Wall -Wcompat

executable minighc
  main-is: Main.hs
  hs-source-dirs: app
  build-depends:
      base >=4.13 && <5
    , minighc
  default-language: Haskell2010
  ghc-options: -Wall -Wcompat

test-suite regression
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  build-depends: base >=4.13 && <5, containers, minighc
  default-language: Haskell2010

source-repository head
  type: git
  location: https://github.com/AHMADALIPARR/minighc.git
