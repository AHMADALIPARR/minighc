cabal-version: 3.0
name: minighc
version: 0.2.0.0
synopsis: A miniature compiler pipeline inspired by GHC
description:
  MiniGHC is an educational from-scratch implementation of a small functional
  language compiler. It demonstrates a concrete surface syntax, bidirectional
  type checking, a call-by-value evaluator, an explicitly typed Core language,
  free-variable analysis, STG conversion, and a simple abstract machine.
license: BSD-3-Clause
license-file: LICENSE
author: MiniGHC contributors
maintainer: example@example.com
category: Compilers
build-type: Simple

library
  exposed-modules: MiniGHC
  hs-source-dirs: src
  build-depends:
      base >=4.15 && <5
    , containers
  default-language: Haskell2010
  ghc-options: -Wall -Wcompat -Wincomplete-uni-patterns -Wincomplete-record-updates

executable minighc
  main-is: Main.hs
  hs-source-dirs: app
  build-depends:
      base >=4.15 && <5
    , minighc
  default-language: Haskell2010
  ghc-options: -Wall -Wcompat -O2
