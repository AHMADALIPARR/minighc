cabal-version: 3.0
name: minighc
version: 0.8.0.0
synopsis: A miniature compiler for a small functional language
description:
  MiniGHC is a compiler for a small functional language with a
  bidirectional type checker, evaluator, Core IR, and free-variable analysis.
license: BSD-3-Clause
license-file: LICENSE
author: MiniGHC contributors
maintainer: example@example.com
category: Compilers
build-type: Simple

library
  exposed-modules:
      MiniGHC
    , MiniGHC.Lint
  hs-source-dirs: src
  build-depends:
      base >=4.15 && <5
    , containers
  default-language: Haskell2010
  ghc-options: -Wall -Wcompat

executable minighc
  main-is: Main.hs
  hs-source-dirs: app
  build-depends:
      base >=4.15 && <5
    , minighc
  default-language: Haskell2010
  ghc-options: -Wall -Wcompat -O2
