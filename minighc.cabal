cabal-version: 3.0
name: minighc
version: 0.6.0.0
synopsis: A miniature compiler pipeline inspired by GHC
description:
  MiniGHC is a compiler for a small functional language together with
  implementations of the classic lambda calculi (STLC, System F, Hindley–Milner)
  that underlie its design.
license: BSD-3-Clause
license-file: LICENSE
author: MiniGHC contributors
maintainer: example@example.com
category: Compilers
build-type: Simple

library
  exposed-modules:
      MiniGHC
    , MiniGHC.Calculi
    , MiniGHC.Calculi.STLC
    , MiniGHC.Calculi.SystemF
    , MiniGHC.Calculi.HM
    , MiniGHC.Lint
    , MiniGHC.Geometry
    , MiniGHC.Geometry.Umbral
    , MiniGHC.Geometry.Grassmann
    , MiniGHC.Geometry.Schubert
    , MiniGHC.Operators
    , MiniGHC.Operators.Heaviside
    , MiniGHC.Analysis
    , MiniGHC.Analysis.Complex
  hs-source-dirs: src
  build-depends:
      base >=4.15 && <5
    , containers
  default-language: Haskell2010
  ghc-options: -Wall -Wcompat -Wincomplete-uni-patterns -Wincomplete-record-updates

executable minighc
  main-is: Main.hs
  hs-source-dirs: app
  build-depends:
      base >=4.15 && <5
    , minighc
  default-language: Haskell2010
  ghc-options: -Wall -Wcompat -O2
